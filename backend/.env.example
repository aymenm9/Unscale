DATABASE_URL=sqlite:///./ledgerwise.db
# production: postgresql+psycopg://user:pass@host/db
FRONTEND_ORIGIN=http://localhost:3000

# ---- Main LLM pool: free OpenAI-compatible providers. Calls rotate across them; a
# rate-limited one rests until its cooldown ends. Several keys per provider: KEY=k1,k2 ----
LLM_PROVIDERS=groq,cloudflare,opencode,axforge,gonka
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENCODE_API_KEY=
OPENCODE_MODEL=
AXFORGE_API_KEY=
AXFORGE_BASE_URL=
AXFORGE_MODEL=
GONKA_API_KEY=
GONKA_BASE_URL=
GONKA_MODEL=

# ---- One model pool per job ("provider" or "provider:model"). Empty = LLM_PROVIDERS ----
LLM_FAST=groq:openai/gpt-oss-20b,gemini:gemini-3.5-flash-lite,cloudflare:@cf/openai/gpt-oss-20b
LLM_READ=gemini:gemini-2.5-flash,cloudflare:@cf/openai/gpt-oss-120b
LLM_JUDGE=groq:openai/gpt-oss-120b,cloudflare:@cf/openai/gpt-oss-120b
LLM_WRITE=groq:openai/gpt-oss-120b,cloudflare:@cf/openai/gpt-oss-120b
LLM_CHECK=gemini:gemini-2.5-flash,groq:qwen/qwen3.8-27b

# ---- Quick filter pool (Gemini Flash Lite + Cloudflare). Empty keys = main pool is used ----
QUICK_FILTER_PROVIDERS=gemini:gemini-3.5-flash-lite,cloudflare:@cf/openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# ---- Cloudflare Workers AI (free daily allowance). Used in both pools ----
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_KEY=
CLOUDFLARE_MODEL=@cf/openai/gpt-oss-120b

# ---- Research tools ----
TAVILY_API_KEY=          # 1,000 free searches/month. Needed for web search.
JINA_API_KEY=            # optional, higher rate limit for the page reader
HUNTER_API_KEY=          # optional, 50 free credits/month, used for top leads only

# ---- Email (Resend) ----
RESEND_API_KEY=
RESEND_FROM=Ledgerwise <onboarding@resend.dev>
RESEND_INBOUND_DOMAIN=   # e.g. abc123.resend.app (Emails > Receiving in Resend)
WEBHOOK_SECRET=          # webhook URL in Resend: https://<api>/api/webhooks/resend?token=<this>
DEMO_INBOX=delivered@resend.dev
PUBLIC_API_URL=http://localhost:3000
SECRET_KEY=change-me
SENDER_NAME=Sam from Ledgerwise
DAILY_SEND_CAP=50

CALCOM_API_KEY=
